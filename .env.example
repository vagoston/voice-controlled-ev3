# LiveKit Cloud project (Settings > Keys in the LiveKit Cloud dashboard)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT + LLM + TTS, all via Groq (console.groq.com)
GROQ_API_KEY=

# EV3 brick (ev3dev). Leave EV3_DRY_RUN=1 to develop without hardware:
# tools return the program they would have run instead of running it.
EV3_DRY_RUN=1
EV3_HOST=
EV3_USER=robot
EV3_PASSWORD=
# micropython is faster to start; python3 gives full CPython on the brick
EV3_PYTHON_BIN=micropython
# Bounded runtime is the real guardrail: the brick exits gracefully just before
# the host watchdog kills the run and forces a stop.
EV3_DEFAULT_TIMEOUT=30
EV3_MAX_TIMEOUT=600
# Loose sanity bound against typos, not policy
EV3_MAX_DURATION=120
